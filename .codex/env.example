# Copy these to Windows User Environment Variables (System Properties → Environment Variables).
# Do NOT commit real values. Codex MCP servers read them via env_vars in ~/.codex/config.toml.

GITHUB_PERSONAL_ACCESS_TOKEN=
FIRECRAWL_API_KEY=
COOLIFY_ACCESS_TOKEN=
COOLIFY_BASE_URL=

# Phase C — plant intelligence (server-only; never expose to the browser)
PLANTNET_API_KEY=
TREFLE_TOKEN=

# Phase 9B — plant_library preview-branch seed (local scripts only; never commit real values)
# Use a Supabase *preview branch* URL + service role from the dashboard (never the anon key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: comma-separated hostnames to hard-block from --apply (e.g. production project host).
GARDEN_PLANT_LIBRARY_SEED_BLOCKED_HOSTS=
# Optional: if set, --apply refuses when SUPABASE_URL hostname equals this (main/prod guard).
GARDEN_SUPABASE_MAIN_PROJECT_HOST=
